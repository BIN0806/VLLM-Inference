# Copy to .env.local (gitignored) and fill in values.
# Never put real secrets, tokens, or live host addresses in committed files.

# --- Provider / connection ---
GPU_PROVIDER=vast
GPU_SSH_HOST=
GPU_SSH_PORT=
GPU_SSH_USER=root
GPU_INSTANCE_ID=
# Optional path to a private key. The tooling never reads key contents.
# Prefer the SSH agent. Leave empty to use the agent.
GPU_SSH_IDENTITY_FILE=
# Defaults to this repository's gitignored .ssh/known_hosts, not ~/.ssh/known_hosts.
GPU_SSH_KNOWN_HOSTS=
GPU_SSH_CONNECT_TIMEOUT=15

# --- Serving endpoint (client-side) ---
# After `make tunnel`, this is typically http://127.0.0.1:8000
VLLM_BASE_URL=http://127.0.0.1:8000
# Remote process listen address on the GPU host (used by the tunnel).
VLLM_REMOTE_HOST=127.0.0.1
VLLM_REMOTE_PORT=18000
VLLM_LOCAL_TUNNEL_PORT=8000
VLLM_TLS_VERIFY=true
# Bind published Compose ports. Default 127.0.0.1; do not expose vLLM on all interfaces.
HOST_BIND=127.0.0.1
# Required for any externally exposed endpoint. Optional for SSH-tunneled tests.
# Does not protect every vLLM endpoint (health/metrics may remain unauthenticated).
VLLM_API_KEY=
# Vast Caddy Open-button token. Used as the Bearer key when VLLM_API_KEY is empty.
# SSH tunnels to 127.0.0.1:18000 skip this layer. Never commit the value.
OPEN_BUTTON_TOKEN=

# --- Image / engine (override per rental; do not assume CUDA 13.0) ---
VLLM_IMAGE=
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=
VLLM_MAX_NUM_SEQS=
VLLM_GPU_MEMORY_UTILIZATION=
DISTRIBUTED_EXECUTOR_BACKEND=mp

# --- Model ---
# Portable baseline: Qwen/Qwen2.5-1.5B-Instruct-AWQ
# Current 3090 validation override: Qwen/Qwen3.5-9B
VLLM_MODEL=
SERVED_MODEL_NAME=
MODEL_REVISION=
HF_HOME=
# Hugging Face token. Never commit the value.
HF_TOKEN=
# Required on some Vast hosts when the Xet download route fails.
HF_HUB_DISABLE_XET=1

# --- Kubernetes render (Phase 3 scaffold; unused until a VM exists) ---
K8S_NAMESPACE=inference
K8S_PVC_SIZE=
K8S_STORAGE_CLASS=local-path
K8S_MODEL_CACHE_PATH=
K8S_CPU_REQUEST=2
K8S_MEMORY_REQUEST=8Gi

# --- Profiles ---
# Authoring / Phase 1–2 examples:
COMPUTE_PROFILE=single-gpu
MODEL_CONFIG=qwen3.5-9b
# Phase 3 first gate: INFERENCE_PROFILE=vast-k3s-replica (1.5B). 9B is vast-k3s-replica-9b only after VRAM discovery.
WORKLOAD_SCENARIO=dev-smoke

# --- Fail-fast fallbacks (default off; never silent) ---
ALLOW_TP_FALLBACK=false
ALLOW_MODEL_FALLBACK=false
ALLOW_OFFLINE_TEST_FALLBACK=false
# Lab-only. Default false. Sending Bearer tokens to non-loopback http:// URLs is refused.
# SSH tunnels to 127.0.0.1/localhost do not need this. Never enable for production.
ALLOW_INSECURE_REMOTE_HTTP=false

# --- Remote execution guard ---
# Leave unset. Set to 1 only after vLLM startup is reported complete.
INFERENCE_ALLOW_REMOTE=0

# Compose interpolation file (not the same as service env_file)
COMPOSE_ENV_FILE=.env.local
